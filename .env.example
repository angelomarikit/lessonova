# Supabase (public)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (server only — never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI providers (server only — never NEXT_PUBLIC_*)
DEEPINFRA_API_KEY=
DEEPINFRA_TEST_MODE=true
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_STREAMING_MODEL=nova-3
# Live STT auto-enables when DEEPGRAM_API_KEY is set (local + Vercel). Set false to disable.
# LIVE_TRANSCRIPTION_ENABLED=false
LIVE_CORRECTIONS_ENABLED=false
# TRANSCRIPTION_AUTO_FALLBACK=false
# DEEPGRAM_ESTIMATED_USD_PER_MINUTE=0.0043
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
CLAUDE_TEST_MODE=true
# In local dev, after transcription succeeds, auto-generate lesson feedback when ANTHROPIC_API_KEY is set.
# AUTO_AI_ANALYSIS=false
# CLAUDE_TEST_DEV_BUDGET_USD=1
# CLAUDE_INPUT_USD_PER_MTOK=0.25
# CLAUDE_OUTPUT_USD_PER_MTOK=1.25

# Email (Phase 4+ — server only)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
